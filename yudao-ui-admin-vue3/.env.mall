# Public production settings for the mall server; contains no credentials.
NODE_ENV=production
VITE_DEV=false
VITE_BASE_URL=https://mall.nexrur.ai
VITE_API_URL=/admin-api
VITE_BASE_PATH=/
VITE_OUT_DIR=dist-mall
VITE_UPLOAD_TYPE=server
VITE_APP_CAPTCHA_ENABLE=true
VITE_APP_API_ENCRYPT_ENABLE=false
VITE_DROP_DEBUGGER=true
VITE_DROP_CONSOLE=true
VITE_SOURCEMAP=false
VITE_COMPRESS=none
